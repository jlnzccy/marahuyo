# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Studio (single-owner gate) ---
# Username + password accepted at /studio/login. Anything else is rejected.
STUDIO_USERNAME=your-username
STUDIO_PASSWORD=your-strong-password
# 32+ byte hex secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET=replace-with-random-hex
